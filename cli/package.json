{
  "name": "@openstays/cli",
  "version": "0.1.0",
  "description": "Command-line and MCP client for the OpenStays HTTP API v1 — availability, bookings, holds, cancellations, promo previews.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openstays": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "nodemailer": "^9.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "fast-uri": "3.1.5",
    "hono": "4.13.1",
    "ip-address": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
