{
  "name": "openstays-app",
  "private": true,
  "version": "0.1.0",
  "description": "OpenStays — open-source booking engine and property-management system for independent lodging: campgrounds, cabins, glamping, small resorts.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepreview": "npm run wavelength:runtime:check -- dist/wavewalletdk",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:runtime": "node scripts/check-runtime-audit.mjs",
    "pretest:e2e:smoke": "npm run wavelength:runtime:check",
    "test:e2e:smoke": "playwright test --config playwright.config.ts",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "seed": "convex run seed:run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "wavelength:runtime": "powershell -ExecutionPolicy Bypass -File scripts/install-wavelength-runtime.ps1",
    "wavelength:runtime:check": "node scripts/check-wavelength-runtime.mjs",
    "mailpit:install": "powershell -ExecutionPolicy Bypass -File scripts/install-mailpit.ps1",
    "mailpit:start": "powershell -ExecutionPolicy Bypass -File scripts/start-mailpit.ps1",
    "mail:bridge": "powershell -ExecutionPolicy Bypass -File scripts/start-mail-bridge.ps1"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@lightninglabs/wavelength-react": "^0.1.0",
    "@lightninglabs/wavelength-web": "^0.1.0",
    "convex": "^1.31.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "convex-test": "^0.0.38",
    "fast-check": "^4.3.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitepress": "^1.6.0",
    "vitest": "^3.2.0"
  }
}
