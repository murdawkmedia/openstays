# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Set automatically by `npx convex dev` into .env.local during development.
VITE_CONVEX_URL=

# Public gallery build only: hides wallet/staff operations and shows sanitized tour.
VITE_PUBLIC_SHOWCASE=false
VITE_PUBLIC_STAFF=false

# ── Convex deployment env vars ──────────────────────────────────────────────
# These are NOT read from this file. Set them per deployment with:
#   npx convex env set NAME value
#
# Payments (configure one or both; M1+):
#   STRIPE_SECRET_KEY            sk_live_... / sk_test_...
#   STRIPE_WEBHOOK_SECRET        whsec_...
#   SQUARE_ACCESS_TOKEN
#   SQUARE_LOCATION_ID
#   SQUARE_WEBHOOK_SIGNATURE_KEY
#   SQUARE_ENV                   "sandbox" (default) | "production"
#
# Hackathon hosted checkout (server-held; use a dedicated Zaprite sandbox org):
#   ZAPRITE_API_KEY
#   ZAPRITE_CUSTOM_CHECKOUT_ID
#   ZAPRITE_WEBHOOK_SECRET        random URL query component; webhook is a nudge only
#   ZAPRITE_API_BASE_URL          optional; defaults to https://api.zaprite.com/v1
#
# Wavelength signet merchant bridge (never expose the token to Vite/browser):
#   WAVELENGTH_BRIDGE_TOKEN
#   WAVELENGTH_SIGNET_SATS_PER_CURRENCY_UNIT  optional; demo default 1000
#
# Fictional public showcase (see docs/public-live-payments.md):
# Frontend build, public values only:
#   VITE_PUBLIC_SHOWCASE=true
#   VITE_PUBLIC_ZAPRITE=false
#   VITE_PUBLIC_WAVELENGTH=false
#   VITE_PUBLIC_SIMULATED=true
#   VITE_PUBLIC_STAFF=false
#   VITE_TURNSTILE_SITE_KEY=public-site-key
#   VITE_PAYMENT_EDGE_URL=https://worker.example.invalid
# Convex policy, start with live rails disabled:
#   PUBLIC_LIVE_PAYMENTS=true
#   PUBLIC_SIMULATED_PAYMENTS=true
#   PUBLIC_ZAPRITE_CONTRIBUTION_CENTS=100
#   WAVELENGTH_PUBLIC_PAYMENT_SATS=1000
#   WAVELENGTH_REWARD_SATS=1000
#   WAVELENGTH_REWARD_DAILY_BUDGET_SATS=0
#   WAVELENGTH_REWARD_MAX_FEE_SATS=210
#   WAVELENGTH_NETWORK=signet
#   ZAPRITE_ENABLED=false
#   WAVELENGTH_ENABLED=false
#   WAVELENGTH_REWARDS_ENABLED=false
# Server/Worker secrets (names only):
#   ELIGIBILITY_HMAC_SECRET, WAVELENGTH_HEARTBEAT_TOKEN,
#   OTS_BRIDGE_TOKEN, OTS_HEARTBEAT_TOKEN,
#   MAIL_BRIDGE_TOKEN, MAIL_HEARTBEAT_TOKEN, BACKUP_HEARTBEAT_TOKEN,
#   TURNSTILE_SECRET, OPERATIONS_ADMIN_TOKEN, CONTAINER_CONTROL_TOKEN,
#   WALLET_BACKUP_KEY_BASE64, WAVELENGTH_WALLET_PASSWORD
#
# Staff auth (Convex Auth; M1+ — see docs/self-hosting for key generation):
#   JWT_PRIVATE_KEY              RS256 private key, PKCS8 PEM
#   JWKS                         matching public JWKS JSON
#
# Optional OAuth sign-in (buttons appear when a provider's pair is set;
# callback URL: https://<deployment>.convex.site/api/auth/callback/<provider>):
#   AUTH_GITHUB_ID / AUTH_GITHUB_SECRET
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
#   AUTH_MICROSOFT_ENTRA_ID_ID / AUTH_MICROSOFT_ENTRA_ID_SECRET
#   AUTH_MICROSOFT_ENTRA_ID_ISSUER   optional, single-tenant Microsoft
#
# Email (M1+; choose resend, mail_bridge, or log_only):
#   EMAIL_PROVIDER              optional; inferred from RESEND_API_KEY when unset
#   RESEND_API_KEY              server-held; only used by the resend provider
#   EMAIL_FROM                   'Property Name <stays@your-domain.example>'
#   MAIL_BRIDGE_TOKEN            shared only by Convex and the local SMTP worker
# Local SMTP worker only (not Convex): SMTP_HOST, SMTP_PORT, SMTP_SECURE,
#   SMTP_USERNAME, SMTP_PASSWORD, MAIL_BRIDGE_POLL_MS
#
# App:
#   SITE_URL                     https://your-booking-site.example
#   DEMO_MODE                    "true" ONLY on the public demo deployment
#                                (simulated payments, nightly reset, and a
#                                synthetic read-mostly demo staff identity —
#                                never set this on a real deployment)
